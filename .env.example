POSTGRES_DB=netplus
POSTGRES_USER=netplus
POSTGRES_PASSWORD=netplus_dev
DB_PORT=5432
REDIS_PORT=6379

# La API corre en el host y se conecta a los contenedores por localhost.
# Si cambias POSTGRES_* o DB_PORT, actualiza también esta URL.
DATABASE_URL=postgres://netplus:netplus_dev@localhost:5432/netplus?sslmode=disable
REDIS_ADDR=localhost:6379

# --- Opcionales (valores por defecto entre paréntesis) ---
# Cuentas iniciales: solo se aplican al crear la base por primera vez.
# ADMIN_EMAIL=admin@nettplus.local
# ADMIN_PASSWORD=NettplusDemo2026!      (mínimo 10 caracteres; cambiarla en un servidor real)
# VIEWER_EMAIL=viewer@nettplus.local
# VIEWER_PASSWORD=ConsultaDemo2026!
# Carga personas y marcaciones ficticias en una base nueva (true).
# SEED_DEMO=true
# Orígenes extra desde los que se aceptan modificaciones, separados por comas.
# ALLOWED_ORIGINS=https://asistencia.miempresa.com
# SESSION_HOURS=8
# LOGIN_MAX_ATTEMPTS=8
# LOGIN_WINDOW_MINUTES=15
