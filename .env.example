POSTGRES_DB=netplus
POSTGRES_USER=netplus
POSTGRES_PASSWORD=netplus_dev
DB_PORT=5432
REDIS_PORT=6379

# La API corre en el host y se conecta a los contenedores por localhost.
# Si cambias POSTGRES_* o DB_PORT, actualiza también esta URL.
DATABASE_URL=postgres://netplus:netplus_dev@localhost:5432/netplus?sslmode=disable
REDIS_ADDR=localhost:6379
