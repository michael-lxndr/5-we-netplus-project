POSTGRES_DB=netplus
POSTGRES_USER=netplus
POSTGRES_PASSWORD=netplus_dev
DB_PORT=5432
REDIS_PORT=6379

# La API corre en el host y se conecta a los contenedores por localhost.
# Si cambias POSTGRES_* o DB_PORT, actualiza también esta URL.
DATABASE_URL=postgres://netplus:netplus_dev@localhost:5432/netplus?sslmode=disable
REDIS_ADDR=localhost:6379

# Cuentas iniciales OBLIGATORIAS al crear una base nueva.
# Completa las contraseñas: mínimo 10 caracteres, máximo 128 bytes.
# Se guardan como hash en PostgreSQL. No uses variables VITE_ para credenciales.
# Con usuarios existentes, edítalos desde Usuarios y permisos; .env no los cambia.
ADMIN_EMAIL=admin@nettplus.local
ADMIN_PASSWORD=
VIEWER_EMAIL=viewer@nettplus.local
VIEWER_PASSWORD=

# Datos ficticios solo si se habilitan explícitamente en una base nueva.
# Esta opción no permite acceder sin autenticación.
SEED_DEMO=false

# --- Opcionales (valores por defecto entre paréntesis) ---
# Orígenes extra desde los que se aceptan modificaciones, separados por comas.
# ALLOWED_ORIGINS=https://asistencia.miempresa.com
# SESSION_HOURS=8
# LOGIN_MAX_ATTEMPTS=8
# LOGIN_WINDOW_MINUTES=15
